# versions.env — single source of truth for every pinned input.
# Read by: lab/Dockerfile (build args), scripts/install-scanners.sh, run.ps1, and CI.
# Populate with scripts/resolve-versions.sh, review the diff, then COMMIT it.
# Every value is immutable: versions + SHA-256 of the exact release archive,
# and container images by digest. Empty values make the build fail closed.

# ---- Your Rocky 9 workstation (built from YOUR Dockerfile on GitHub) --------
# Pin the Git context to a full 40-char commit SHA, never a branch:
#   https://github.com/<user>/<repo>.git#<commit-sha>:<folder containing Dockerfile>
# A local folder path also works (e.g. C:/src/rocky9-workstation).
WORKSTATION_GIT_CONTEXT=
WORKSTATION_IMAGE=eegr580/rocky9-workstation:local
# lab = workstation + lab layer (default) | standalone = provision from public Rocky 9
LAB_TARGET=lab
# Developer account inside the lab (your workstation already creates 'aaron')
LAB_USER=aaron

# ---- Base images (by digest) ------------------------------------------------
ROCKY_IMAGE=docker.io/rockylinux/rockylinux:9@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f
APP_BASE_IMAGE=docker.io/library/python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable@sha256:9624669db72f54d86c4b46a7064518bd9bf79d8c61a4c31befa9923489f328af

# ---- Release binaries (linux/amd64) -----------------------------------------
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
# Trivy: never 0.69.4, 0.69.5 or 0.69.6 (malicious releases, March 2026, CVE-2026-33634).
TRIVY_VERSION=0.76.2
TRIVY_SHA256=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf
GRYPE_VERSION=0.121.2
GRYPE_SHA256=9c8965ced9df657e5e851c14021bae838802f711edd7a48f9bc3c923a8d28f12
SYFT_VERSION=1.57.0
SYFT_SHA256=9c077a7d43029b3b13e98a8db720661e700c4d58db6352153a06395ae4a2a704

# ---- Python-distributed scanners (installed into an isolated venv) ----------
SEMGREP_VERSION=1.184.0
CHECKOV_VERSION=3.4.3
